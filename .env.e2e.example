# Copy to .env.e2e (git-ignored), then run scripts/e2e.sh.
# The account must exist on the server, without MFA, and the server must allow v4 resources.
PASSBOLT_E2E_SERVER_ADDRESS=https://passbolt-api.ddev.site
PASSBOLT_E2E_USER_PRIVATE_KEY_FILE=../passbolt-pro-api/plugins/PassboltDev/TestData/config/gpg/ada_private.key
PASSBOLT_E2E_USER_PASSWORD=ada@passbolt.com
# From a container where *.ddev.site resolves to itself: pin the name to the Docker host.
PASSBOLT_E2E_RESOLVE=passbolt-api.ddev.site:443:172.17.0.1
# ddev serves a mkcert certificate this machine may not trust.
PASSBOLT_E2E_TLS_SKIP_VERIFY=true
